rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    function hasExactKeys(data, keys) {
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys);
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function isNullableString(value) {
      return value == null || value is string;
    }

    function isInstant(value) {
      return value is string
        && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z');
    }

    function isNonNegativeInteger(value) {
      return value is int && value >= 0;
    }

    function isDiscipline(value) {
      return value in ['boxing', 'kickboxing', 'muay_thai', 'k1', 'mma_striking'];
    }

    function isCategory(value) {
      return value in ['technique', 'pads', 'bag', 'sparring', 'conditioning', 'strengthAndConditioning', 'mixed'];
    }

    function isDocumentIdentity(data, documentId) {
      return data.schemaVersion is int && data.schemaVersion == 1
        && data.id is string && data.id == documentId
        && isInstant(data.createdAt) && isInstant(data.updatedAt);
    }

    function isWorkoutPlan(data, documentId) {
      return hasExactKeys(data, [
          'schemaVersion', 'id', 'disciplineKey', 'customName', 'nameSnapshot',
          'mainGoal', 'createdAt', 'updatedAt', 'blocks'
        ])
        && isDocumentIdentity(data, documentId)
        && isDiscipline(data.disciplineKey)
        && isNullableString(data.customName)
        && isNonEmptyString(data.nameSnapshot)
        && isNullableString(data.mainGoal)
        // The model sets no length limit for blocks, sparring or exerciseRatings.
        // List entries are validated by the application's infrastructure schemas.
        && data.blocks is list;
    }

    function isBoundedText(value, maximum) {
      return value is string && value.size() >= 1 && value.size() <= maximum;
    }

    function isOpenCorrection(value) {
      return value == null || (value is map
        && hasExactKeys(value, ['problem', 'fix', 'sessionId', 'workoutDate'])
        && isBoundedText(value.problem, 200)
        && isBoundedText(value.fix, 200)
        && isNonEmptyString(value.sessionId)
        && value.workoutDate is string
        && value.workoutDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'));
    }

    function isFocusSkill(data, documentId) {
      return data.keys().hasAll([
          'schemaVersion', 'id', 'name', 'criterion', 'openCorrection',
          'archivedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly(['schemaVersion', 'id', 'name', 'criterion', 'openCorrection',
          'archivedAt', 'createdAt', 'updatedAt', 'exerciseId'])
        && data.id == documentId && isInstant(data.createdAt) && isInstant(data.updatedAt)
        && ((data.schemaVersion is int && data.schemaVersion == 1 && !('exerciseId' in data))
          || (data.schemaVersion is int && data.schemaVersion == 2 && 'exerciseId' in data
            && (data.exerciseId == null || isLibraryId(data.exerciseId))))
        && isBoundedText(data.name, 80)
        && isBoundedText(data.criterion, 200)
        && isOpenCorrection(data.openCorrection)
        && (data.archivedAt == null || isInstant(data.archivedAt));
    }

    function isLibraryId(value) {
      return value is string && value.matches('[^/]{1,128}');
    }

    function isExerciseConfiguration(value) {
      return value is map && (
        (value.mode == 'rounds' && hasExactKeys(value, ['mode', 'roundCount', 'roundDurationSeconds', 'restBetweenRoundsSeconds'])
          && value.roundCount is int && value.roundCount >= 1 && value.roundCount <= 99
          && value.roundDurationSeconds is int && value.roundDurationSeconds >= 1 && value.roundDurationSeconds <= 86400
          && value.restBetweenRoundsSeconds is int && value.restBetweenRoundsSeconds >= 0 && value.restBetweenRoundsSeconds <= 86400)
        || (value.mode == 'continuous' && hasExactKeys(value, ['mode', 'durationSeconds'])
          && value.durationSeconds is int && value.durationSeconds >= 1 && value.durationSeconds <= 86400));
    }

    function isPersonalExercise(data, documentId) {
      return data.keys().hasAll(['schemaVersion', 'id', 'namePl', 'type', 'disciplines', 'blockTypes',
          'defaultConfiguration', 'archivedAt', 'favorite', 'lastUsedAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['schemaVersion', 'id', 'namePl', 'type', 'disciplines', 'blockTypes',
          'defaultConfiguration', 'copiedFromId', 'archivedAt', 'favorite', 'lastUsedAt', 'createdAt', 'updatedAt'])
        && isDocumentIdentity(data, documentId) && isLibraryId(data.id)
        && isBoundedText(data.namePl, 100)
        && data.type in ['combination', 'drill', 'continuous']
        && data.disciplines is list && data.disciplines.size() >= 1 && data.disciplines.size() <= 5
        && data.disciplines.toSet().size() == data.disciplines.size()
        && data.disciplines.hasOnly(['boxing', 'kickboxing', 'muay_thai', 'k1', 'mma_striking'])
        && data.blockTypes is list && data.blockTypes.size() >= 1 && data.blockTypes.size() <= 8
        && data.blockTypes.toSet().size() == data.blockTypes.size()
        && data.blockTypes.hasOnly(['warmup', 'technique', 'pads', 'bag', 'sparring', 'conditioning', 'strengthAndConditioning', 'cooldown'])
        && isExerciseConfiguration(data.defaultConfiguration)
        && (!('copiedFromId' in data) || isLibraryId(data.copiedFromId))
        && (data.archivedAt == null || isInstant(data.archivedAt))
        && data.favorite is bool && (data.lastUsedAt == null || isInstant(data.lastUsedAt));
    }

    function commonSessionKeys() {
      return [
        'schemaVersion', 'id', 'source', 'status', 'disciplineKey', 'category',
        'workoutDate', 'timezone', 'durationSeconds', 'workSeconds', 'sparringSeconds',
        'completion', 'note', 'rpe', 'rpeRecordedAt', 'sparring', 'createdAt', 'updatedAt'
      ];
    }

    function isWeekPlan(data, documentId) {
      return hasExactKeys(data, [
          'schemaVersion', 'weekStart', 'items', 'createdAt', 'updatedAt', 'editedAfterWeekEnd'
        ])
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.weekStart is string && data.weekStart == documentId
        && data.weekStart.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && isInstant(data.createdAt) && isInstant(data.updatedAt)
        && data.editedAfterWeekEnd is bool
        // Actual Monday, unique item IDs and item variants are checked by zod/mini.
        && data.items is list && data.items.size() <= 14;
    }

    function isCompletion(value, unit) {
      return value is map
        && hasExactKeys(value, ['completed', 'planned', 'unit'])
        && isNonNegativeInteger(value.completed)
        && isNonNegativeInteger(value.planned)
        && value.completed <= value.planned
        && value.unit == unit;
    }

    function isTimedSession(data, unit) {
      return isInstant(data.startedAt) && isInstant(data.completedAt)
        && data.completedAt >= data.startedAt
        && isNonNegativeInteger(data.workSeconds)
        && isNonNegativeInteger(data.sparringSeconds)
        && isCompletion(data.completion, unit)
        && data.stepResults is list && data.stepResults.size() <= 500;
    }

    function isSessionSource(data) {
      let common = commonSessionKeys();
      let timed = ['startedAt', 'completedAt', 'stepResults'];
      return (data.source == 'plan'
          && hasExactKeys(data, common.concat(timed).concat([
            'workoutPlanId', 'workoutPlanNameSnapshot', 'focusRatings', 'exerciseRatings'
          ]))
          && isTimedSession(data, 'exercise')
          && isNonEmptyString(data.workoutPlanId)
          && isNonEmptyString(data.workoutPlanNameSnapshot)
          && data.focusRatings is list && data.focusRatings.size() <= 3
          && data.exerciseRatings is list)
        || (data.source == 'quickTimer'
          && hasExactKeys(data, common.concat(timed))
          && isTimedSession(data, 'round'))
        || (data.source == 'manual'
          && (data.schemaVersion == 1 ? hasExactKeys(data, common.concat(['focusRatings']))
            : data.schemaVersion == 2 && hasExactKeys(data, common.concat(['focusRatings', 'parts'])) && isManualParts(data))
          && data.status == 'completed'
          && data.completion == null
          && data.workSeconds == null && data.sparringSeconds == null
          && data.focusRatings is list && data.focusRatings.size() <= 3
          && data.rpe is int && data.rpe >= 0 && data.rpe <= 10
          && isInstant(data.rpeRecordedAt)
          && data.durationSeconds is int && data.durationSeconds >= 60 && data.durationSeconds <= 28800
          && data.sparring is list && data.sparring.size() <= 1);
    }

    function isManualParts(data) {
      return data.parts is list && data.parts.size() >= 1 && data.parts.size() <= 6
        && data.parts.toSet().size() == data.parts.size()
        && data.parts.hasOnly(['technique', 'pads', 'bag', 'sparring', 'conditioning', 'other'])
        && data.category == (data.parts.size() == 1 && data.parts[0] != 'other' ? data.parts[0] : 'mixed')
        && data.sparring.size() == (data.parts.hasAny(['sparring']) ? 1 : 0);
    }

    function isWorkoutSession(data, documentId) {
      return isSessionSource(data)
        && (isDocumentIdentity(data, documentId) || (data.source in ['manual', 'plan'] && data.schemaVersion is int && data.schemaVersion == 2
          && data.id is string && data.id == documentId && isInstant(data.createdAt) && isInstant(data.updatedAt)))
        && data.status in ['completed', 'partial']
        && isDiscipline(data.disciplineKey)
        && isCategory(data.category)
        && data.workoutDate is string && data.workoutDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.timezone is string && data.timezone.matches('[A-Za-z_]+(/[A-Za-z0-9_+-]+)*')
        && data.durationSeconds is number && data.durationSeconds > 0
        && (data.note == null || (data.note is string && data.note.size() <= 1000))
        && (data.rpe == null || (data.rpe is int && data.rpe >= 0 && data.rpe <= 10))
        && (data.rpeRecordedAt == null || isInstant(data.rpeRecordedAt))
        && data.sparring is list;
    }

    function isHealthConsent(value) {
      return value == null || (value is map
        && hasExactKeys(value, ['grantedAt', 'noticeVersion', 'adultConfirmed'])
        && isInstant(value.grantedAt)
        && value.noticeVersion is string && value.noticeVersion.matches('[0-9]{4}-[0-9]{2}')
        && value.adultConfirmed == true);
    }

    function isProfile(data) {
      return data.keys().hasAll(['schemaVersion', 'healthDataConsent', 'weightClassLabel', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['schemaVersion', 'healthDataConsent', 'wellbeingConsent', 'wellbeingWithdrawal', 'weightClassLabel', 'createdAt', 'updatedAt'])
        && data.schemaVersion is int && data.schemaVersion == 1
        && isInstant(data.createdAt) && isInstant(data.updatedAt)
        && isHealthConsent(data.healthDataConsent)
        && isHealthConsent(data.get('wellbeingConsent', null))
        && isWellbeingWithdrawal(data.get('wellbeingWithdrawal', null))
        && (data.get('wellbeingWithdrawal', null) == null || !data.wellbeingWithdrawal.pending || data.get('wellbeingConsent', null) != null)
        && (data.weightClassLabel == null || isBoundedText(data.weightClassLabel, 20))
        && (data.healthDataConsent != null || data.weightClassLabel == null);
    }

    function isBodyWeight(data, date) {
      return hasExactKeys(data, ['schemaVersion', 'date', 'weightKg', 'createdAt', 'updatedAt'])
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.date is string && data.date == date && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.weightKg is number && data.weightKg >= 30 && data.weightKg <= 250
        && isInstant(data.createdAt) && isInstant(data.updatedAt);
    }

    function isWellbeingRating(value) {
      return value is int && value >= 1 && value <= 5;
    }

    function isWellbeing(data, date) {
      return hasExactKeys(data, ['schemaVersion', 'questionsVersion', 'date', 'sleep', 'energy', 'soreness', 'stress', 'note', 'createdAt', 'updatedAt'])
        && data.schemaVersion is int && data.schemaVersion == 1
        && data.questionsVersion is int && data.questionsVersion == 1
        && data.date is string && data.date == date && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && isWellbeingRating(data.sleep) && isWellbeingRating(data.energy)
        && isWellbeingRating(data.soreness) && isWellbeingRating(data.stress)
        && (data.note == null || (data.note is string && data.note.size() <= 300))
        && isInstant(data.createdAt) && isInstant(data.updatedAt);
    }

    function hasWellbeingConsent(uid) {
      let profile = get(/databases/$(database)/documents/users/$(uid)).data;
      let consent = profile.get('wellbeingConsent', null);
      let withdrawal = profile.get('wellbeingWithdrawal', null);
      return consent != null && isHealthConsent(consent) && consent.noticeVersion == '2026-11'
        && (withdrawal == null || !withdrawal.pending);
    }

    function isWellbeingWithdrawal(value) {
      return value == null || (value is map && hasExactKeys(value, ['generation', 'pending'])
        && value.generation is int && value.generation >= 1 && value.generation <= 9007199254740991
        && value.pending is bool);
    }

    function isWellbeingConsentTransition(before, after) {
      let previous = before.get('wellbeingWithdrawal', null);
      let next = after.get('wellbeingWithdrawal', null);
      let consent = before.get('wellbeingConsent', null);
      let nextConsent = after.get('wellbeingConsent', null);
      let pending = previous != null && previous.pending;
      let generation = previous == null ? 0 : previous.generation;
      // Keep the completed counter: no earlier batch may restart or finish a later generation.
      return pending
        ? (next != null && next.generation == generation
          && (next.pending ? nextConsent == consent : nextConsent == null))
        : ((next == previous && (consent == null || nextConsent == consent))
          || (next != null && next.pending && consent != null && nextConsent == consent
            && next.generation == generation + 1));
    }

    match /users/{uid} {
      allow read, delete: if isVerifiedOwner(uid);
      allow create: if isVerifiedOwner(uid) && isProfile(request.resource.data)
        && request.resource.data.get('wellbeingWithdrawal', null) == null;
      allow update: if isVerifiedOwner(uid) && isProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.healthDataConsent == null || request.resource.data.healthDataConsent == null
          || request.resource.data.healthDataConsent == resource.data.healthDataConsent)
        && isWellbeingConsentTransition(resource.data, request.resource.data);
    }

    match /users/{uid}/readiness/{date} {
      // Reads/deletes remain available for export, account deletion and interrupted withdrawal.
      allow read, delete: if isVerifiedOwner(uid);
      allow create: if isVerifiedOwner(uid) && hasWellbeingConsent(uid) && isWellbeing(request.resource.data, date);
      allow update: if isVerifiedOwner(uid) && hasWellbeingConsent(uid) && isWellbeing(request.resource.data, date)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{uid}/bodyWeights/{date} {
      allow read, delete: if isVerifiedOwner(uid);
      allow create: if isVerifiedOwner(uid)
        && get(/databases/$(database)/documents/users/$(uid)).data.healthDataConsent != null
        && isBodyWeight(request.resource.data, date);
      allow update: if isVerifiedOwner(uid)
        && get(/databases/$(database)/documents/users/$(uid)).data.healthDataConsent != null
        && isBodyWeight(request.resource.data, date)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{uid}/workoutPlans/{documentId} {
      allow read, delete: if isVerifiedOwner(uid);
      allow create, update: if isVerifiedOwner(uid)
        && isWorkoutPlan(request.resource.data, documentId);
    }

    match /users/{uid}/workoutSessions/{documentId} {
      allow read, delete: if isVerifiedOwner(uid);
      allow create, update: if isVerifiedOwner(uid)
        && isWorkoutSession(request.resource.data, documentId);
    }

    match /users/{uid}/exercises/{documentId} {
      allow read, delete: if isVerifiedOwner(uid);
      allow create: if isVerifiedOwner(uid) && isPersonalExercise(request.resource.data, documentId);
      allow update: if isVerifiedOwner(uid) && isPersonalExercise(request.resource.data, documentId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.type == resource.data.type
        && request.resource.data.get('copiedFromId', null) == resource.data.get('copiedFromId', null);
    }

    match /users/{uid}/focusSkills/{documentId} {
      allow read, delete: if isVerifiedOwner(uid);
      allow create, update: if isVerifiedOwner(uid)
        && isFocusSkill(request.resource.data, documentId);
    }

    match /users/{uid}/weekPlans/{documentId} {
      allow read, delete: if isVerifiedOwner(uid);
      allow create: if isVerifiedOwner(uid) && isWeekPlan(request.resource.data, documentId);
      allow update: if isVerifiedOwner(uid) && isWeekPlan(request.resource.data, documentId)
        && request.resource.data.createdAt == resource.data.createdAt
        && (resource.data.editedAfterWeekEnd != true || request.resource.data.editedAfterWeekEnd == true);
    }

    // All other documents and subcollections are denied by default.
  }
}
