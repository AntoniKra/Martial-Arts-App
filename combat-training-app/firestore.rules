rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    function hasExactKeys(data, keys) {
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys);
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function isNullableString(value) {
      return value == null || value is string;
    }

    function isInstant(value) {
      return value is string
        && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z');
    }

    function isNonNegativeInteger(value) {
      return value is int && value >= 0;
    }

    function isDiscipline(value) {
      return value in ['boxing', 'kickboxing', 'muay_thai', 'k1', 'mma_striking'];
    }

    function isCategory(value) {
      return value in ['technique', 'pads', 'bag', 'sparring', 'conditioning', 'strengthAndConditioning', 'mixed'];
    }

    function isDocumentIdentity(data, documentId) {
      return data.schemaVersion is int && data.schemaVersion == 1
        && data.id is string && data.id == documentId
        && isInstant(data.createdAt) && isInstant(data.updatedAt);
    }

    function isWorkoutPlan(data, documentId) {
      return hasExactKeys(data, [
          'schemaVersion', 'id', 'disciplineKey', 'customName', 'nameSnapshot',
          'mainGoal', 'createdAt', 'updatedAt', 'blocks'
        ])
        && isDocumentIdentity(data, documentId)
        && isDiscipline(data.disciplineKey)
        && isNullableString(data.customName)
        && isNonEmptyString(data.nameSnapshot)
        && isNullableString(data.mainGoal)
        // The model sets no length limit for blocks, sparring or exerciseRatings.
        // List entries are validated by the application's infrastructure schemas.
        && data.blocks is list;
    }

    function isBoundedText(value, maximum) {
      return value is string && value.size() >= 1 && value.size() <= maximum;
    }

    function isOpenCorrection(value) {
      return value == null || (value is map
        && hasExactKeys(value, ['problem', 'fix', 'sessionId', 'workoutDate'])
        && isBoundedText(value.problem, 200)
        && isBoundedText(value.fix, 200)
        && isNonEmptyString(value.sessionId)
        && value.workoutDate is string
        && value.workoutDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'));
    }

    function isFocusSkill(data, documentId) {
      return hasExactKeys(data, [
          'schemaVersion', 'id', 'name', 'criterion', 'openCorrection',
          'archivedAt', 'createdAt', 'updatedAt'
        ])
        && isDocumentIdentity(data, documentId)
        && isBoundedText(data.name, 80)
        && isBoundedText(data.criterion, 200)
        && isOpenCorrection(data.openCorrection)
        && (data.archivedAt == null || isInstant(data.archivedAt));
    }

    function commonSessionKeys() {
      return [
        'schemaVersion', 'id', 'source', 'status', 'disciplineKey', 'category',
        'workoutDate', 'timezone', 'durationSeconds', 'workSeconds', 'sparringSeconds',
        'completion', 'note', 'rpe', 'rpeRecordedAt', 'sparring', 'createdAt', 'updatedAt'
      ];
    }

    function isCompletion(value, unit) {
      return value is map
        && hasExactKeys(value, ['completed', 'planned', 'unit'])
        && isNonNegativeInteger(value.completed)
        && isNonNegativeInteger(value.planned)
        && value.completed <= value.planned
        && value.unit == unit;
    }

    function isTimedSession(data, unit) {
      return isInstant(data.startedAt) && isInstant(data.completedAt)
        && data.completedAt >= data.startedAt
        && isNonNegativeInteger(data.workSeconds)
        && isNonNegativeInteger(data.sparringSeconds)
        && isCompletion(data.completion, unit)
        && data.stepResults is list && data.stepResults.size() <= 500;
    }

    function isSessionSource(data) {
      let common = commonSessionKeys();
      let timed = ['startedAt', 'completedAt', 'stepResults'];
      return (data.source == 'plan'
          && hasExactKeys(data, common.concat(timed).concat([
            'workoutPlanId', 'workoutPlanNameSnapshot', 'focusRatings', 'exerciseRatings'
          ]))
          && isTimedSession(data, 'exercise')
          && isNonEmptyString(data.workoutPlanId)
          && isNonEmptyString(data.workoutPlanNameSnapshot)
          && data.focusRatings is list && data.focusRatings.size() <= 3
          && data.exerciseRatings is list)
        || (data.source == 'quickTimer'
          && hasExactKeys(data, common.concat(timed))
          && isTimedSession(data, 'round'))
        || (data.source == 'manual'
          && hasExactKeys(data, common)
          && data.status == 'completed'
          && data.completion == null
          && (data.workSeconds == null || isNonNegativeInteger(data.workSeconds))
          && (data.sparringSeconds == null || isNonNegativeInteger(data.sparringSeconds)));
    }

    function isWorkoutSession(data, documentId) {
      return isSessionSource(data)
        && isDocumentIdentity(data, documentId)
        && data.status in ['completed', 'partial']
        && isDiscipline(data.disciplineKey)
        && isCategory(data.category)
        && data.workoutDate is string && data.workoutDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.timezone is string && data.timezone.matches('[A-Za-z_]+(/[A-Za-z0-9_+-]+)*')
        && data.durationSeconds is number && data.durationSeconds > 0
        && (data.note == null || (data.note is string && data.note.size() <= 1000))
        && (data.rpe == null || (data.rpe is int && data.rpe >= 0 && data.rpe <= 10))
        && (data.rpeRecordedAt == null || isInstant(data.rpeRecordedAt))
        && data.sparring is list;
    }

    match /users/{uid}/workoutPlans/{documentId} {
      allow read, delete: if isVerifiedOwner(uid);
      allow create, update: if isVerifiedOwner(uid)
        && isWorkoutPlan(request.resource.data, documentId);
    }

    match /users/{uid}/workoutSessions/{documentId} {
      allow read, delete: if isVerifiedOwner(uid);
      allow create, update: if isVerifiedOwner(uid)
        && isWorkoutSession(request.resource.data, documentId);
    }

    match /users/{uid}/focusSkills/{documentId} {
      allow read, delete: if isVerifiedOwner(uid);
      allow create, update: if isVerifiedOwner(uid)
        && isFocusSkill(request.resource.data, documentId);
    }

    // All other documents and subcollections are denied by default.
  }
}
