# Konfiguracja aplikacji webowej Firebase (Project settings → Your apps).
# Te wartości są publiczne z założenia, ale nie wpisujemy ich do repozytorium.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Opcjonalny emulator lokalny: 127.0.0.1:9099 (wymaga projektu demo-).
VITE_FIREBASE_AUTH_EMULATOR_HOST=
# Opcjonalny emulator Firestore: 127.0.0.1:8080 (wymaga demo- i emulatora Auth).
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=
