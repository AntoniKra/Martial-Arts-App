{
  "name": "combat-training-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:deploy": "tsc --noEmit && vite build --mode deploy",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "firebase emulators:exec --only auth --project demo-combat-training --config firebase.json --non-interactive \"playwright test\"",
    "spike:firestore:typecheck": "tsc --noEmit --project spikes/firestore-offline/tsconfig.json",
    "spike:firestore:build": "vite build --config spikes/firestore-offline/vite.config.ts",
    "spike:firestore:test": "firebase emulators:exec --only firestore --project demo-combat-training --config spikes/firestore-offline/firebase.json --non-interactive \"playwright test --config spikes/firestore-offline/playwright.config.ts\"",
    "test:watch": "vitest",
    "generate:pwa-icons": "pwa-assets-generator --preset minimal-2023 public/icons/temporary-mark.svg"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "firebase": "13.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "15.34.2",
    "globals": "^17.14.0",
    "postcss": "8.5.32",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "7.4.1"
  }
}
